# SQLite for local dev. Swap to a Postgres URL in production:
# DATABASE_URL="postgresql://user:password@host:5432/dbname"
DATABASE_URL="file:./dev.db"

# Generate a strong random value, e.g.: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"

# Where uploaded files are stored on disk (swap for S3 in production,
# see src/lib/storage.ts)
UPLOAD_DIR="./uploads"
